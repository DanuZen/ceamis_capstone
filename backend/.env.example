# AI Service Environment Variables
PORT=8000

# Akan diisi setelah model training selesai
MODEL_PATH=app/models/health_score_v1.keras

# chatbot
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_LLM=gemini
MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=10

# Supabase Auth & JWT Secret (Wajib untuk pengamanan router admin)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Sakelar Persistensi Data (bawaan: memory; ganti ke 'db' setelah migrasi SQL dijalankan)
PERSISTENCE_BACKEND=memory