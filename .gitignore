# ═══════════════════════════════════════════════
# CEAMIS — Monorepo .gitignore
# ═══════════════════════════════════════════════

# ── Dependencies ──────────────────────────────
**/node_modules/
**/.pnp
**/.pnp.js

# ── Build Output ──────────────────────────────
**/dist/
**/build/
**/.next/
**/.nuxt/
**/out/

# ── Logs ──────────────────────────────────────
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ── Testing & Coverage ────────────────────────
**/coverage/
**/.nyc_output/

# ── OS Files ──────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ── NestJS Specific ───────────────────────────
**/.nest/

# ── Next.js Specific ──────────────────────────
**/next-env.d.ts

# ── Python / AI Service ───────────────────────
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.Python
**/pip-log.txt
**/pip-delete-this-directory.txt
**/.env.ai
**/venv/
**/.venv/
**/env/
**/*.egg-info/
**/*.egg
**/.eggs/

# ── ML Model Artifacts (besar, jangan di-commit) ──
**/artifacts_risk/**/*.pkl
**/artifacts_risk/**/*.joblib
**/artifacts_risk/**/*.h5
**/artifacts_risk/**/*.pt
**/artifacts_risk/**/*.bin

# ── Misc ──────────────────────────────────────
**/.cache/
**/tmp/
**/temp/
