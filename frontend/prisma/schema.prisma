// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model EducationModule {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  reads     Int      @default(0)
  status    String   @default("draft") // "published" | "draft"
  points    Int      @default(200)
  duration  String
  desc      String
  pages     EducationPage[]
  quizzes   EducationQuiz[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model EducationPage {
  id        Int      @id @default(autoincrement())
  moduleId  Int
  module    EducationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subtitle  String
  text      String
  pageOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model EducationQuiz {
  id            Int      @id @default(autoincrement())
  moduleId      Int
  module        EducationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question      String
  options       String[]
  correctAnswer Int
  points        Int      @default(150)
  status        String   @default("active")
  explanation   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model FinancialBudget {
  id        Int      @id @default(autoincrement())
  userId    String   // Points to auth.users id, but not strictly bound by foreign key in schema to avoid pooler issues
  limit     Float
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model FinancialTarget {
  id            Int      @id @default(autoincrement())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  icon          String   @default("target")
  color         String   @default("lime")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model FinancialDebt {
  id            Int      @id @default(autoincrement())
  userId        String
  name          String
  type          String   // "payble" or "receivable"
  amount        Float
  dueDate       DateTime?
  status        String   @default("unpaid") // "unpaid" | "paid"
  icon          String   @default("utensils")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("public")
}

model RiskProfile {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  profile         String   // "Conservative", "Moderate", "Aggressive"
  answers         String   // JSON stringified array of answers
  aiRecommendation String? // JSON stringified recommendations
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("public")
}

model GamificationBadge {
  id              String   @id // e.g. "budget_master"
  name            String
  desc            String
  icon            String
  requirementType String
  requirementValue Int
  xp              Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("public")
}
